# Variables de entorno para la API de Styluu
# Copia este archivo a .env.local o configura estas variables en EasyPanel

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://styluu_user:CAMBIA_ESTA_CONTRASEÑA@styluu-postgres:5432/styluu

# Poner true si tu PostgreSQL requiere SSL (normalmente no en EasyPanel interno)
DATABASE_SSL=false

# Puerto del servidor API (por defecto 3001)
PORT=3001

# Origen permitido para CORS (URL de tu app React en producción)
# Puedes poner * para permitir todos los origenes (menos seguro pero más fácil)
CORS_ORIGIN=*
